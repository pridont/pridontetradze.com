---
layout: "base.njk"
title: "Home"
description: "All about learning, creating, teaching. Mostly tech and humanities."
image: "/assets/images/cover.jpg"
---

<div class="ledger">
  <section class="section">
    <div class="section__index">00 — hello</div>
    <div class="section__body">
      <h1 class="hero__title">Hi, I'm Pridon.</h1>
      <p class="hero__intro measure">
        I like
        <span class="hl-green">learning</span>,
        <span class="hl-blue">creating</span>, and
        <span class="hl-plum">teaching</span>. I keep this small corner of the
        internet to share my thoughts and work.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__index">01 — currently</div>
    <div class="section__body">
      <dl class="currently">
        <dt>reading</dt>
        <dd>Pseudo-Dionysius, again</dd>
        <dt>building</dt>
        <dd>stuff</dd>
        <dt>feeding</dt>
        <dd>three cats</dd>
        <dt>listening</dt>
        <dd>to Pat Metheny</dd>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="section__index">02 — works</div>
    <div class="section__body">
      {# Numbers come from the loop, not the data — reordering src/data/works.js
         does not mean renumbering by hand. #}
      <ol class="works">
        {%- for work in works %}
        <li class="work">
          <span class="work__num">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span>
          <a class="work__name" href="{{ work.url }}">{{ work.name }}</a>
          <span class="work__tag">{{ work.tag }}</span>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="section__index">03 — find me</div>
    <div class="section__body">
      <ul class="findme">
        {%- include "find-me.njk" -%}
      </ul>
    </div>
  </section>
</div>
