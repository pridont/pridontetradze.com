---
permalink: "robots.txt"
eleventyExcludeFromCollections: true
---
{#
# robots.txt — https://pridontetradze.com
#
# This file is a request, not a control. Well-behaved crawlers honour it;
# scrapers, email harvesters and hostile bots ignore it entirely. It is also not
# a deindexing tool: a Disallow'd URL can still be indexed if something links to
# it. Pages that must stay out of results carry a `noindex` meta tag instead
# (see src/includes/partials/head.njk) — which requires them to stay crawlable.

# --- Search engines: full access ---------------------------------------------
# Scripts and styles are deliberately NOT blocked. Search engines render pages
# before ranking them; hiding assets makes the site look broken to the renderer.
User-agent: *
Allow: /
Disallow: /404.html

# --- AI training crawlers: opted out -----------------------------------------
# These collect corpora for model training. Blocked. AI *search* agents are
# allowed further down, so this site can still be cited in assistant answers.
#
# Both lists live in src/data/robots.js.
#}
{% for agent in robots.blocked %}
User-agent: {{ agent }}
Disallow: /
{% endfor %}
{#
# --- AI search & user-initiated fetches: allowed ------------------------------
# These retrieve a page to answer a question and cite it, rather than to train.
# Listed explicitly so they are never caught by a future blanket rule.
#}
{% for agent in robots.allowed %}
User-agent: {{ agent }}
Allow: /
{% endfor %}
Sitemap: {{ "/sitemap.xml" | absoluteUrl(site.url) }}
