<!DOCTYPE html>
{# Georgian-titled posts declare lang="ka" so screen readers pick the right
   voice; a page may override with an explicit `lang` in front matter. #}
<html lang="{{ lang or ('ka' if (title | hasGeorgian) else 'en') }}">
  {% include "head.njk" %}
  {%- set accentClass = "" -%}
  {%- if tags -%}
    {%- if "academic" in tags -%}{%- set accentClass = "theme-academic" -%}
    {%- elif "personal" in tags -%}{%- set accentClass = "theme-personal" -%}
    {%- else -%}{%- set accentClass = "theme-tech" -%}
    {%- endif -%}
  {%- endif -%}
  <body class="{{ accentClass }}{% if bodyClass %} {{ bodyClass }}{% endif %}">
    {% include "header.njk" %}
    <main>
      {{ content | safe }}
    </main>
    {% include "footer.njk" %}
    {% if env.paletteLab %}{% include "palette-switcher.njk" %}{% endif %}
  </body>
</html>
