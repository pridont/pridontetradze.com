<head>
  {# Set once and reused below for the cover preload, the article stylesheet
     block and the og:type — /blog/ itself is the index, not a post. #}
  {%- set isArticle = "/blog/" in page.url and page.url !== "/blog/" -%}

  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {# theme-color sits here — before the pre-paint script — so that script can
     point it at the resolved theme immediately, keeping the mobile browser
     chrome from flashing dark on a light-theme load (and vice versa). A single
     meta is deliberate: theme/index.js rewrites this same element's content on
     toggle, so media-scoped duplicates would fight the manual override. #}
  <meta name="theme-color" content="{{ theme.dark }}">

  {# Set the theme on <html> before any paint to avoid a flash of the wrong theme. #}
  <script>
    (function () {
      try {
        var t =
          localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        if (t === "light") document.documentElement.classList.add("light");
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute("content", t === "light" ? "{{ theme.light }}" : "{{ theme.dark }}");
      } catch (e) {}
    })();
  </script>

  {# --- Fonts --- #}
  {# Load Google Fonts non-render-blocking: the print media type keeps the
     stylesheet off the critical path, then onload flips it to all. display=swap
     paints fallback text immediately, so no new flash is introduced.

     The rel=preload in front of each sheet is what makes that affordable.
     media="print" on its own drops the request to the lowest fetch priority,
     so the fonts arrive long after first paint and the swap is guaranteed to
     be visible; the preload restores a normal priority without putting the
     cross-origin request back on the critical path.

     Two requests, not one: only the Georgian family can be usefully subset.
     Both URLs are assembled in src/data/fonts.js — see the note there on the
     &text= subset, which cuts Noto Sans Georgian from 41.5KB to 15.7KB on
     every page. #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="{{ fonts.latin }}">
  <link rel="stylesheet" href="{{ fonts.latin }}" media="print" onload="this.media='all'">
  {%- if fonts.georgian %}
  <link rel="preload" as="style" href="{{ fonts.georgian }}">
  <link rel="stylesheet" href="{{ fonts.georgian }}" media="print" onload="this.media='all'">
  {%- endif %}
  <noscript>
    <link rel="stylesheet" href="{{ fonts.latin }}">
    {%- if fonts.georgian %}
    <link rel="stylesheet" href="{{ fonts.georgian }}">
    {%- endif %}
  </noscript>

  {# --- LCP cover --- #}
  {# Preloaded here rather than left for the parser to find in the article
     body, which sits behind ~17KB of inlined CSS. Only emits for self-hosted
     covers; remote ones (imgur/ytimg) have no generated variants. #}
  {%- if isArticle and image %}
  {{ image | imagePreload | safe }}
  {%- endif %}

  {# --- Design tokens + base (always), inlined + minified to avoid render-blocking requests --- #}
  <style>{{ "tokens.css" | inlineCss | safe }}{{ "main.css" | inlineCss | safe }}</style>

  {# --- Palette lab (local only, PALETTE_LAB=1): alt palettes + pre-paint switch script --- #}
  {% if env.paletteLab %}
    <style>{{ "palette-lab.css" | inlineCss | safe }}</style>
    <script>{{ "palette/index.js" | inlineJs | safe }}</script>
  {% endif %}

  {# --- Page-specific styles (inlined) --- #}
  {% if page.url === "/" %}
    <style>{{ "elements/home.css" | inlineCss | safe }}</style>
  {% endif %}
  {% if "/about" in page.url %}
    <style>{{ "elements/about.css" | inlineCss | safe }}</style>
  {% endif %}
  {% if page.url === "/blog/" or "/tags/" in page.url %}
    <style>{{ "elements/writing.css" | inlineCss | safe }}</style>
  {% endif %}
  {% if isArticle %}
    {# The syntax theme only earns its 2KB on posts that actually have a code
       block — several don't, and keying on the URL shipped it to all of them. #}
    <style>{{ "elements/article.css" | inlineCss | safe }}{% if "<pre" in (content | string) %}{{ "highlight-theme.css" | inlineCss | safe }}{% endif %}</style>
  {% endif %}
  {% if "/cats" in page.url %}
    <style>{{ "elements/cats.css" | inlineCss | safe }}</style>
    <script defer src="/scripts/cats.js"></script>
  {% endif %}
  {% if "/music" in page.url %}
    <style>{{ "elements/music.css" | inlineCss | safe }}</style>
    <script src="/wavesurfer.js" type="module"></script>
    <script defer src="/scripts/music.js" type="module"></script>
  {% endif %}

  <link rel="icon" href="/assets/icons/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">

  <script>{{ "main.js" | inlineJs | safe }}</script>

  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">

  {% if tags and "post" in tags %}
  <link rel="alternate" type="text/markdown" href="{{ page.url | replace(r/\/$/, "") }}.md">
  {% endif %}

  {% if page.url === "/404.html" %}
    <meta name="robots" content="noindex, follow">
  {% endif %}

  {# Social / SEO. Images must be absolute for every scraper (og:image is
     ignored when relative). Fall back to the site defaults so a page that
     forgets its own image/description never ships an empty tag. #}
  {%- set ogImage = (image or site.defaultImage) | absoluteUrl(site.url) -%}
  {%- set ogDesc = description or site.description -%}

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:description" content="{{ ogDesc }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  {% if isArticle %}<meta property="article:published_time" content="{{ page.date | dateToRfc3339 }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ ogDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <meta name="description" content="{{ ogDesc }}">
  <title>{{ title }} {% if title %} | {% endif %} {{ site.name }}</title>
</head>
