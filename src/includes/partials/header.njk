<header class="site-header">
  <div class="site-header__inner container">
    <a class="wordmark" href="/">
      <span>{{ site.wordmark | safe }} <span class="wordmark__place">· {{ page.url | shellPath }}</span></span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {%- for item in nav %}{%- if item.primary %}
      <a class="site-nav__link" href="{{ item.href }}" {% if page.url | navCurrent(item) %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endif %}{%- endfor %}
      {% include "theme-toggle.njk" %}
      <button class="menu-toggle" id="menu-open" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="Site menu">
  <div class="mobile-menu__bar container">
    <span class="wordmark">
      <span>{{ site.wordmark | safe }}</span>
    </span>
    <div class="mobile-menu__actions">
      {% include "theme-toggle.njk" %}
      <button class="menu-toggle" id="menu-close" type="button" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  {# Every nav entry, not just the primary ones — the mobile menu is the full
     map of the site. Labels are stored lowercase once and title-cased here
     rather than kept twice in the data. #}
  <nav class="mobile-menu__nav container" aria-label="Pages">
    {%- for item in nav %}
    <a href="{{ item.href }}" {% if page.url | navCurrent(item) %}aria-current="page"{% endif %}><span class="mobile-menu__num" aria-hidden="true">{{ item.num }}</span>{{ item.label | capitalize }}</a>
    {%- endfor %}
  </nav>

  <div class="mobile-menu__find container">
    <p class="kicker">find me</p>
    <ul class="mobile-menu__links">
      {%- include "find-me.njk" -%}
    </ul>
  </div>

  <footer class="mobile-menu__footer container">
    <span>&copy; {% year %}</span>
    <span class="prayer geo">
      <span class="cross" aria-hidden="true">{%- include "cross.njk" -%}</span>
      {{ site.motto.mkhedruli }}
    </span>
  </footer>
</dialog>
